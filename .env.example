# Postgres connection string (Neon recommended — works on Cloudflare Workers via HTTP)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign auth sessions (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="change-me"

# Base URL of the app (used by Better Auth for cookies/redirects)
# Local dev: http://localhost:8080 (check the port Vite prints)
BETTER_AUTH_URL="http://localhost:8080"